---
// 共通レイアウトを読み込む。
import BaseLayout from "../../../layouts/BaseLayout.astro";
// 共通の製品詳細表示を読み込む。
import ProductDetail from "../../../components/ProductDetail.astro";
// microCMSから英語の製品データを取得する。
import { getCatalog } from "../../../lib/microcms";

// 英語用の製品URLを静的生成する。
export async function getStaticPaths() {
  // ビルド時に英語の製品一覧を取得する。
  const { products } = await getCatalog("en");
  // 製品データからURLパラメータを作成する。
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

// 静的ページ用の製品データを受け取る。
const { product } = Astro.props;
---

<BaseLayout lang="en" title={`${product.modelNumber} | ${product.name}`} description={`Product information for ${product.name} (${product.modelNumber}).`}>
  <ProductDetail product={product} productIndexPath="/en/products/" contactPath="/en/contact/" labels={{ back: "Back to product list", overview: "Overview", modelNumber: "Model number", contact: "Ask about this product", imageAlt: "product image" }} />
</BaseLayout>
