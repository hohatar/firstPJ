---
// 共通レイアウトを読み込む。
import BaseLayout from "../../../layouts/BaseLayout.astro";
// 製品カテゴリの絞り込み表示を読み込む。
import ProductCatalog from "../../../components/ProductCatalog.astro";
// microCMSから英語のカタログを取得する。
import { getCatalog } from "../../../lib/microcms";

// ビルド時に英語のカタログデータを取得する。
const { categories, products } = await getCatalog("en");
---

<BaseLayout lang="en" title="Products" description="ASD ESD products for electrostatic control and ionization.">
  <section class="page-hero compact"><p class="eyebrow">PRODUCTS</p><h1>Electrostatic-control products<br /><em>for your application.</em></h1><p>Specifications and documents will be published after their review is complete.</p></section>
  <ProductCatalog categories={categories} products={products} productBasePath="/en/products" labels={{ categoryEyebrow: "CATEGORY", categoryTitle: "Product categories", all: "All", productsEyebrow: "ALL PRODUCTS", productsTitle: "Product list", productLinkLabel: "View product information" }} />
</BaseLayout>
