---
// 共通レイアウトを読み込む。
import BaseLayout from "../../../layouts/BaseLayout.astro";
// 共通の製品詳細表示を読み込む。
import ProductDetail from "../../../components/ProductDetail.astro";
// microCMSから日本語の製品データを読み込む。
import { getCatalog } from "../../../lib/microcms";

// 日本語製品のURLを静的生成する。
export async function getStaticPaths() {
  // ビルド時に日本語の製品一覧を取得する。
  const { products } = await getCatalog("ja");
  // 製品slugからURLパラメータを設定する。
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

// 静的ページ用の製品データを受け取る。
const { product } = Astro.props;
---

<BaseLayout lang="ja" title={`${product.modelNumber} | ${product.name}`} description={`${product.name}（${product.modelNumber}）の製品情報です。`}>
  <ProductDetail product={product} productIndexPath="/ja/products/" contactPath="/ja/contact/" labels={{ back: "製品一覧へ戻る", overview: "製品概要", modelNumber: "型番", contact: "この製品について相談する", imageAlt: "製品画像" }} />
</BaseLayout>
