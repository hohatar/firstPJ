---
// 共通レイアウトを読み込む。
import BaseLayout from "../../layouts/BaseLayout.astro";
// 共通の製品詳細表示を読み込む。
import ProductDetail from "../../components/ProductDetail.astro";
// microCMSから中国語の製品データを取得する。
import { getCatalog } from "../../lib/microcms";

// 中国語用の製品URLを静的生成する。
export async function getStaticPaths() {
  // ビルド時に中国語の製品一覧を取得する。
  const { products } = await getCatalog("zh");
  // 既存製品の識別子を中国語URLへ渡す。
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

// 静的ページ用の製品データを受け取る。
const { product } = Astro.props;
---

<BaseLayout lang="zh" title={`${product.modelNumber} | 产品展示`} description={`${product.name}（${product.modelNumber}）产品信息。`}>
  <ProductDetail product={product} productIndexPath="/products/" contactPath="/contact/" labels={{ back: "返回产品列表", overview: "产品概述", modelNumber: "型号", contact: "咨询此产品", imageAlt: "产品图片" }} />
</BaseLayout>
