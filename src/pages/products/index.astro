---
// 共通レイアウトを読み込む。
import BaseLayout from "../../layouts/BaseLayout.astro";
// microCMSから中国語のカテゴリと製品を取得する。
import { getCatalog } from "../../lib/microcms";

// ビルド時に中国語のカタログを取得する。
const { categories, products } = await getCatalog("zh");
---

<BaseLayout lang="zh" title="产品展示" description="北京亚司达科技发展有限公司产品展示。">
  <section class="page-hero compact"><p class="eyebrow">PRODUCTS</p><h1>产品展示</h1><p>以下分类和代表型号根据现有网站整理。详细参数、图片和资料将在确认后补充。</p></section>
  <section class="section product-catalog"><div class="catalog-group"><div class="catalog-title"><p class="eyebrow">CATEGORY</p><h2>产品分类</h2></div><div class="category-list">{categories.map((category, index) => <a href="#all-products"><span>{String(index + 1).padStart(2, "0")}</span>{category.name}<b>↗</b></a>)}</div></div><div class="catalog-group" id="all-products"><div class="catalog-title"><p class="eyebrow">ALL PRODUCTS</p><h2>产品列表</h2></div><div class="catalog-items">{products.map((product) => <a class="product-row" href={`/products/${product.slug}/`}><span>{product.modelNumber}</span><strong>{product.name}</strong><small>查看产品信息</small><b>→</b></a>)}</div></div></section>
</BaseLayout>
