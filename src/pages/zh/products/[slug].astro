---
// 共通レイアウトを読み込む。
import BaseLayout from "../../../layouts/BaseLayout.astro";
// microCMSから中国語の製品データを取得する。
import { getCatalog } from "../../../lib/microcms";

// 中国語用の製品URLを静的生成する。
export async function getStaticPaths() {
  // ビルド時に中国語の製品一覧を取得する。
  const { products } = await getCatalog("zh");
  // 既存製品の識別子を中国語URLへ渡す。
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

// 静的ページ用の製品データを受け取る。
const { product } = Astro.props;
---

<BaseLayout lang="zh" title={`${product.modelNumber} | 产品展示`} description={`${product.name}（${product.modelNumber}）产品信息。`}>
  <section class="product-detail-hero"><a href="/zh/products/">← 返回产品列表</a><p class="eyebrow">PRODUCT</p><h1>{product.modelNumber}</h1><p>{product.name}</p></section>
  <section class="section detail-grid"><div class="product-visual detail-visual"><span>{product.modelNumber}</span></div><div class="detail-copy"><p class="eyebrow">OVERVIEW</p><h2>{product.name}</h2><p>产品详细参数、适用范围、图片和资料将在microCMS确认和发布后补充。</p><dl><div><dt>型号</dt><dd>{product.modelNumber}</dd></div><div><dt>显示顺序</dt><dd>{product.displayOrder}</dd></div></dl><a class="button button-primary" href="/zh/contact/">咨询此产品</a></div></section>
</BaseLayout>
